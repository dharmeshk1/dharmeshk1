---
import BaseLayout from '../layouts/BaseLayout.astro';
const areas=[
['01','Electrochemical Biosensing','Nanomaterial-enabled platforms for biomedical detection.'],
['02','Computational Modelling','Molecular simulation and electronic-structure approaches.'],
['03','Nanomaterials','Structure, properties and interfaces for sensing applications.'],
['04','Drug Repurposing','Computational investigation of drug–target interactions.']
];
---
<BaseLayout title="Dharmesh Kumar — Research" description="Research portfolio of Dharmesh Kumar — biosensing, nanomaterials, computational modelling and molecular science.">
<section class="hero">
  <p class="eyebrow">RESEARCH IDENTITY / INDIA</p>
  <h1>Dharmesh<br /><em>Kumar</em></h1>
  <p class="lead">Computational & Experimental Research in Biosensing, Nanomaterials and Molecular Science.</p>
  <div class="actions"><a class="button" href="/research">Explore research ↗</a><a class="text-link" href="/about">About me</a></div>
</section>
<section class="home-intro">
  <div class="section-label">01 / RESEARCH PROFILE</div>
  <div><h2>Bridging experiments<br />with <em>computation.</em></h2><p>I work across experimental biosensing and computational modelling, exploring how materials, molecules and biological systems can be understood and engineered for biomedical applications.</p><a class="arrow-link" href="/about">More about my work →</a></div>
</section>
<section class="section">
  <div class="section-label">02 / RESEARCH AREAS</div>
  <div class="research-grid">
    {areas.map(a=><a class="research-card" href="/research"><span>{a[0]}</span><h3>{a[1]}</h3><p>{a[2]}</p><b>View area →</b></a>)}
  </div>
</section>
<section class="section feature-project">
  <div class="section-label">03 / FEATURED PROJECT</div>
  <div><span class="project-kicker">PROJECT 01</span><h2>HIV Electrochemical<br /><em>Biosensor</em></h2><p>Integrated experimental and computational investigation of nanomaterial-based electrochemical biosensing for HIV detection.</p><a class="button" href="/projects">View projects ↗</a></div>
</section>
<section class="home-links">
  <a href="/publications"><span>04 / PUBLICATIONS</span><strong>Scientific work →</strong></a>
  <a href="/cv"><span>05 / CV</span><strong>Academic record →</strong></a>
  <a href="/contact"><span>06 / CONTACT</span><strong>Let's connect →</strong></a>
</section>
</BaseLayout>