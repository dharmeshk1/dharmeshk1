---
import BaseLayout from '../layouts/BaseLayout.astro';
const projects=[
['PROJECT 01','HIV Electrochemical Biosensor','Integrated experimental and computational investigation of nanomaterial-based electrochemical biosensing for HIV detection.','Biosensing · Nanomaterials · Modelling'],
['PROJECT 02','Molecular & Materials Modelling','Computational exploration of molecular structure, electronic properties, interactions and material behaviour.','Molecular science · Electronic structure'],
['PROJECT 03','Data-Driven Simulation','Building and analysing computational datasets to explore simulation trends and future machine-learning workflows.','Simulation · Data · Machine learning']
];
---
<BaseLayout section="Projects" title="Projects — Dharmesh Kumar" description="Selected research projects by Dharmesh Kumar.">
<section class="page-hero compact"><p class="eyebrow">PROJECTS</p><h1>From scientific question<br />to <em>research system.</em></h1></section>
<section class="project-page-list">
{projects.map(p=><article><div><span>{p[0]}</span><h2>{p[1]}</h2><p>{p[2]}</p><small>{p[3]}</small></div><b>↗</b></article>)}
</section>
</BaseLayout>