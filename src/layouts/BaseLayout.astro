---
import '../styles/global.css';
const base = import.meta.env.BASE_URL;
const { title = 'Dharmesh Kumar — Research', description = 'Research portfolio of Dharmesh Kumar.' } = Astro.props;
---
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width" />
<title>{title}</title>
<meta name="description" content={description} />
</head>
<body>
<header class="nav">
  <a class="brand" href={base}>DK<span>.</span></a>
  <nav aria-label="Primary navigation">
    <a href={base}>Home</a>
    <a href={base + 'about/'}>About</a>
    <a href={base + 'research/'}>Research</a>
    <a href={base + 'projects/'}>Projects</a>
    <a href={base + 'publications/'}>Publications</a>
    <a href={base + 'cv/'}>CV</a>
    <a href={base + 'contact/'}>Contact</a>
  </nav>
</header>
<main><slot /></main>
<footer>© 2026 Dharmesh Kumar <span>Research identity</span></footer>
</body>
</html>